# Copy this file to `.env` on the EC2 host and fill in real values.
# NEVER commit the real .env file to git.

# --- Database ---
# For a local Postgres container on the same EC2 host, or an RDS free-tier instance,
# or a Supabase Postgres instance (get these from Supabase Project Settings > Database).
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=canteen_saarthi
DB_USERNAME=canteen_user
DB_PASSWORD=change-me-strong-password
DB_SSL_MODE=require
DB_POOL_SIZE=10

# --- CORS ---
# The public domain(s) the frontend will be served from.
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- Server ---
SERVER_PORT=8080

# --- Auth ---
# APP_JWT_SECRET must be a long random string (32+ characters). Generate one with:
#   openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_JWT_EXPIRATION_MINUTES=480

# Seeded once on first startup if no users exist yet. Log in with this, then
# create real named accounts via POST /api/users and stop using this one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
